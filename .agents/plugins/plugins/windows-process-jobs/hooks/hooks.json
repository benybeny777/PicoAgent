{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const r=process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT;import(require('node:url').pathToFileURL(require('node:path').join(r,'hooks','session-hook.mjs')).href)\"",
            "timeout": 5,
            "statusMessage": "Windowsジョブ通知の所有先を設定中"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const r=process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT;import(require('node:url').pathToFileURL(require('node:path').join(r,'hooks','notification-hook.mjs')).href)\"",
            "timeout": 5,
            "statusMessage": "Windowsジョブの通知を確認中"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const r=process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT;import(require('node:url').pathToFileURL(require('node:path').join(r,'hooks','notification-hook.mjs')).href)\"",
            "timeout": 5,
            "statusMessage": "Windowsジョブの通知を確認中"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const r=process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT;import(require('node:url').pathToFileURL(require('node:path').join(r,'hooks','notification-hook.mjs')).href)\"",
            "timeout": 5,
            "statusMessage": "Windowsジョブの通知を確認中"
          }
        ]
      }
    ]
  }
}
