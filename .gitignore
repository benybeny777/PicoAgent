# xtask（開発タスクランナー）のビルド成果物
xtask/target/

# Rust / Tauri ビルド成果物
src-tauri/target/
src-tauri/gen/
# OSS化準備中のライブラリcrateは単体検証時の生成物とlockを追跡しない。
crates/*/target/
crates/*/Cargo.lock

# 同梱物（cargo xtask setup で取得）・モデル重み（巨大なので含めない）
src-tauri/resources/bundled/engine/*
!src-tauri/resources/bundled/engine/.gitkeep
src-tauri/resources/bundled/aivis/*
!src-tauri/resources/bundled/aivis/.gitkeep
src-tauri/resources/bundled/whisper/*
!src-tauri/resources/bundled/whisper/.gitkeep
src-tauri/resources/bundled/office/*
!src-tauri/resources/bundled/office/.gitkeep
src-tauri/resources/bundled/tools/*
!src-tauri/resources/bundled/tools/.gitkeep
src-tauri/resources/engine/
src-tauri/resources/aivis/*
!src-tauri/resources/aivis/.gitkeep
*.gguf

# モバイル用アイコン（`npx tauri icon` が生成するが、対応OSはWindows/macOSだけで
# NSIS・macOSバンドルのどちらも参照しない。再生成しても追跡しない）
src-tauri/icons/ios/
src-tauri/icons/android/

# 生成物・一時ファイル
dist/
ui-dist/
.tmp/
/tmp-*
/temp/

# キャラの配信コピー（正本は characters/。cargo xtask sync-characters で生成）
ui/assets/characters/

# Live2D ランタイムと公式サンプルモデル（cargo xtask setup live2d で取得。再配布条件があるため含めない）
ui/vendor/pixi/
ui/vendor/live2d/
characters/*/live2d/
# 自作のむぎモデルはPicoAgentの配布物として追跡する。
!characters/mugi/live2d/
!characters/mugi/live2d/**


# Live2D 制作用 PSD（python scripts/build-live2d-psd.py で layers/ から再生成できる）
characters/*/live2d-src/

# ローカル設定（個人 PC 専用。app_config_dir に保存されるが念のため）
config.json

# Python バイトコードキャッシュ
__pycache__/

# 作業用ツールが作る Node のパッケージ置き場（Node はアプリの依存ではないので含めない）
node_modules/

# OS別の追加機能パッケージ（releaseへ別途アップロードする大容量生成物）
distribution/components/
# 廃止済みTHA3が開発機に残っていても再混入させない
src-tauri/resources/bundled/tha3/
src-tauri/resources/bundled/tha3-bootstrap/
tools/tha3/
tools/tha3-runtime/
temp/tha3-uv-cache/
