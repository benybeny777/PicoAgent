# 既定: テキストは自動判定し、リポジトリ内では LF に正規化する。
* text=auto eol=lf

# 固定第三者バンドル内のシェーダー文字列とライセンス原文の空白を保持する。
ui/vendor/mmd/mmd-runtime.js -whitespace
ui/vendor/mmd/LICENSES.txt -whitespace

# バイナリ（差分・改行変換しない）
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.icns binary
*.gguf binary
*.moc3 binary
*.psd filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
# 既存履歴は書き換えず、この指定後に追加・更新するキャラクター画像からLFSへ載せる。
characters/**/*.png  filter=lfs diff=lfs merge=lfs -text
characters/**/*.webp filter=lfs diff=lfs merge=lfs -text
docs/images/character-sena.webp        filter=lfs diff=lfs merge=lfs -text
docs/images/character-sena-stream.webp filter=lfs diff=lfs merge=lfs -text
*.dll  binary
*.exe  binary
*.pptx binary
*.woff  binary
*.woff2 binary
