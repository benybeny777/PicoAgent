# 既定: テキストは自動判定し、リポジトリ内では LF に正規化する。
* text=auto eol=lf

# バイナリ（差分・改行変換しない）
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.icns binary
*.gguf binary
*.moc3 binary
*.psd filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.dll  binary
*.exe  binary
*.woff  binary
*.woff2 binary
