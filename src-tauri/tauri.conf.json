{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PicoAgent",
  "version": "1.0.1",
  "identifier": "com.picoagent.desktop",
  "build": {
    "frontendDist": "../ui-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "PicoAgent",
        "width": 680,
        "height": 430,
        "minWidth": 200,
        "minHeight": 240,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "shadow": false,
        "resizable": true,
        "maximizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' blob: data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
          "scope": ["$APPDATA/characters/**", "$APPDATA/display/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/bundled/**/*", "resources/component-manifest.json"],
    "windows": {
      "nsis": {
        "compression": "zlib",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
