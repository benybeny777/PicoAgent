{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PicoAgent",
  "version": "1.2.17",
  "identifier": "com.picoagent.desktop",
  "build": {
    "frontendDist": "../ui-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "url": "index.html",
        "title": "PicoAgent",
        "visible": false,
        "width": 680,
        "height": 430,
        "minWidth": 200,
        "minHeight": 240,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "shadow": false,
        "resizable": true,
        "maximizable": true,
        "additionalBrowserArgs": "--disable-http-cache"
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; img-src 'self' blob: data: asset: http://asset.localhost; media-src 'self' blob: data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
          "scope": ["$DATA/PicoAgent/characters/**", "$DATA/PicoAgent/display/**", "$DATA/PicoAgent/character-maker/characters/**", "$DATA/PicoAgent/generated-media/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/bundled/**/*": "resources/bundled/",
      "resources/component-manifest.json": "resources/component-manifest.json",
      "../character-maker/sidecar/**/*": "character-maker/sidecar/",
      "../character-maker/installer/setup-runtime-models.py": "character-maker/installer/setup-runtime-models.py",
      "../character-maker/workflows/**/*": "character-maker/workflows/"
    },
    "windows": {
      "nsis": {
        "compression": "zlib",
        "languages": ["Japanese"],
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
