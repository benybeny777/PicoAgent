{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PicoAgent",
  "version": "1.0.0",
  "identifier": "com.coda.app",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "node scripts/stop-stale.mjs && node scripts/sync-characters.mjs",
    "beforeBuildCommand": "node scripts/stop-stale.mjs && node scripts/sync-characters.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "PicoAgent",
        "width": 560,
        "height": 430,
        "minWidth": 420,
        "minHeight": 340,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "shadow": false,
        "resizable": true,
        "maximizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/engine/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
